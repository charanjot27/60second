NODE_ENV=production
PORT=3000

# Brand and domain. Sites live at <slug>.ROOT_DOMAIN
BRAND_NAME=site60
ROOT_DOMAIN=site60.in
CONTACT_EMAIL=hello@site60.in
ABUSE_EMAIL=abuse@site60.in

# The bot's WhatsApp number, international format without + (landing page and site footers)
BOT_WHATSAPP_NUMBER=919876543210

# WhatsApp Cloud API (Meta for Developers > your app > WhatsApp)
WA_PHONE_NUMBER_ID=
WA_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=pick-any-long-random-string
WA_API_VERSION=v21.0

# Anthropic API: Opus writes the copy, art-directs, designs and edits Advanced sites
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_FALLBACK_MODEL=
ANTHROPIC_DESIGN_MODEL=claude-opus-5-5

# MongoDB (Atlas free tier works)
MONGO_URL=mongodb+srv://user:pass@cluster.mongodb.net
MONGO_DB=site60

# Cloudflare R2 (S3-compatible image storage)
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=site60-images
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
IMAGE_PUBLIC_BASE=https://img.site60.in

# Google Gemini (free tier, aistudio.google.com/apikey): writes copy and designs Advanced sites
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# AI pictures for Advanced sites, tried in this order: OpenAI (best), Gemini, Cloudflare, then a free public service
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
# Only with a paid Gemini plan, for example gemini-2.5-flash-image
GEMINI_IMAGE_MODEL=
CF_ACCOUNT_ID=
CF_AI_TOKEN=
CF_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Owner numbers (digits only, comma separated) that skip all usage limits, for testing
ADMIN_NUMBERS=
# Optional limit overrides per phone number
LIMIT_SITES_PER_DAY=3
LIMIT_ADVANCED_PER_DAY=3
LIMIT_EDITS_PER_DAY=15
LIMIT_AI_CALLS_PER_DAY=30
LIMIT_PHOTOS_PER_HOUR=20
