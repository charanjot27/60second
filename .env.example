NODE_ENV=production
PORT=3000

# Brand and domain. Sites live at <slug>.ROOT_DOMAIN
BRAND_NAME=site60
ROOT_DOMAIN=site60.in
CONTACT_EMAIL=hello@site60.in
ABUSE_EMAIL=abuse@site60.in

# The bot's WhatsApp number, international format without + (landing page and site footers)
BOT_WHATSAPP_NUMBER=919876543210

# WhatsApp Cloud API (Meta for Developers > your app > WhatsApp)
WA_PHONE_NUMBER_ID=
WA_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=pick-any-long-random-string
WA_API_VERSION=v21.0
# Optional approved WhatsApp templates, used to reach owners after the 24-hour chat window closes
WA_LEAD_TEMPLATE=
WA_ALERT_TEMPLATE=
WA_TEMPLATE_LANG=en

# Anthropic API: Opus designs and edits websites; small questions go to Gemini or Haiku
ANTHROPIC_API_KEY=
# Backup small model for chat, reading answers, photo checks and daily lessons; Gemini goes first when GEMINI_API_KEY is set. Empty turns it off
ANTHROPIC_CHAT_MODEL=claude-haiku-5-5
ANTHROPIC_DESIGN_MODEL=claude-opus-5-5
# Thinking depth for building pages: high (default) or xhigh for the most polished results
DESIGN_EFFORT=high

# MongoDB (Atlas free tier works)
MONGO_URL=mongodb+srv://user:pass@cluster.mongodb.net
MONGO_DB=site60

# Cloudflare R2 (S3-compatible image storage)
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=site60-images
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
IMAGE_PUBLIC_BASE=https://img.site60.in

# Google Gemini (free tier, aistudio.google.com/apikey): writes copy and designs Advanced sites
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Stronger Gemini model used to design pages when Claude is unavailable
GEMINI_DESIGN_MODEL=gemini-3-flash-preview

# Real stock photos (free API keys). Claude compares them with the AI pictures and picks the best for each spot
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
PIXABAY_API_KEY=
# AI pictures for Advanced sites, tried in this order: OpenAI (best), Gemini, Cloudflare, then a free public service
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
# Only with a paid Gemini plan, for example gemini-3.1-flash-image
GEMINI_IMAGE_MODEL=
CF_ACCOUNT_ID=
CF_AI_TOKEN=
# Cloudflare picture models, best first; refused or over-quota models are skipped for 6 hours
CF_IMAGE_MODELS=@cf/leonardo/lucid-origin,@cf/black-forest-labs/flux-1-schnell
# Voice notes are transcribed with Cloudflare Workers AI (same keys), Gemini is the backup
CF_WHISPER_MODEL=@cf/openai/whisper-large-v3-turbo

# Payments. Stripe (card, Apple Pay, Google Pay) is used when its key is set; set PAYMENTS=razorpay to use Razorpay (UPI) instead
PAYMENTS=stripe
STRIPE_SECRET_KEY=
# Webhook at https://ROOT_DOMAIN/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Prices in PRICE_CURRENCY. Set a plan to 0 to hide it
PRICE_CURRENCY=USD
PRICE_MONTHLY=0
PRICE_BIWEEKLY=9
# Optional label shown instead of the automatic one, for example "$9 a month or $5 every 2 weeks"
PRICE_LABEL=
# Razorpay (UPI, UPI Autopay, cards, Apple Pay). Webhook at https://ROOT_DOMAIN/razorpay/webhook
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Razorpay plans for autopay (Subscriptions > Plans), same amounts as above
RAZORPAY_PLAN_ID=
RAZORPAY_PLAN_BIWEEKLY_ID=
# self: owners buy their own domain from any registrar and the bot connects it. resell: the bot buys it with Porkbun credit
DOMAIN_MODE=self
# Optional Porkbun keys (porkbun.com/account/api): prices next to suggestions, and buying in resell mode. Needs RENDER_API_KEY too
PORKBUN_API_KEY=
PORKBUN_SECRET_KEY=
# Owner pays the Porkbun price plus this margin each year (in PRICE_CURRENCY), rounded up
DOMAIN_MARGIN=5
# PRICE_CURRENCY units per US dollar, for example 84 when prices are in INR
USD_RATE=1
# Skip names that cost more than this in US dollars, first year or renewal
DOMAIN_MAX_USD=25
TRIAL_HOURS=24
# Demo mode: enforce free trials without any payment. Owners reply "keep it" and you activate from WhatsApp
TRIALS=on

# Owners' own domains are added to the Render service through the Render API
RENDER_API_KEY=
# Render sets RENDER_SERVICE_ID and RENDER_EXTERNAL_HOSTNAME automatically
RENDER_APEX_IP=216.24.57.1

# Optional email copies of enquiry alerts (resend.com), sent to the address the owner sets with "email you@example.com"
RESEND_API_KEY=
ALERT_EMAIL_FROM=site60 <alerts@site60.in>

# Admin dashboard at https://ROOT_DOMAIN/admin (user: admin)
ADMIN_PASSWORD=
# Secret for signing payment links (defaults to WA_APP_SECRET)
LINK_SECRET=

# Owner numbers (digits only, comma separated) that skip all usage limits, for testing
ADMIN_NUMBERS=
# Optional limit overrides per phone number
LIMIT_SITES_PER_DAY=3
LIMIT_ADVANCED_PER_DAY=3
LIMIT_EDITS_PER_DAY=15
LIMIT_AI_CALLS_PER_DAY=30
LIMIT_PHOTOS_PER_HOUR=20
LIMIT_EDITS_PER_DAY=15
LIMIT_VOICE_PER_DAY=20
