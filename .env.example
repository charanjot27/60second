NODE_ENV=production
PORT=3000

# Brand and domain. Sites live at <slug>.ROOT_DOMAIN
BRAND_NAME=site60
ROOT_DOMAIN=site60.in
CONTACT_EMAIL=hello@site60.in
ABUSE_EMAIL=abuse@site60.in

# The bot's WhatsApp number, international format without + (landing page and site footers)
BOT_WHATSAPP_NUMBER=919876543210

# WhatsApp Cloud API (Meta for Developers > your app > WhatsApp)
WA_PHONE_NUMBER_ID=
WA_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=pick-any-long-random-string
WA_API_VERSION=v21.0
# Optional approved WhatsApp templates, used to reach owners after the 24-hour chat window closes
WA_LEAD_TEMPLATE=
WA_ALERT_TEMPLATE=
WA_TEMPLATE_LANG=en

# Anthropic API: Opus writes the copy, art-directs, designs and edits Advanced sites
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_FALLBACK_MODEL=
ANTHROPIC_DESIGN_MODEL=claude-opus-5-5

# MongoDB (Atlas free tier works)
MONGO_URL=mongodb+srv://user:pass@cluster.mongodb.net
MONGO_DB=site60

# Cloudflare R2 (S3-compatible image storage)
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=site60-images
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
IMAGE_PUBLIC_BASE=https://img.site60.in

# Google Gemini (free tier, aistudio.google.com/apikey): writes copy and designs Advanced sites
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# AI pictures for Advanced sites, tried in this order: OpenAI (best), Gemini, Cloudflare, then a free public service
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
# Only with a paid Gemini plan, for example gemini-2.5-flash-image
GEMINI_IMAGE_MODEL=
CF_ACCOUNT_ID=
CF_AI_TOKEN=
CF_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# Voice notes are transcribed with Cloudflare Workers AI (same keys), Gemini is the backup
CF_WHISPER_MODEL=@cf/openai/whisper-large-v3-turbo

# Billing (Stripe Checkout: card, Apple Pay and Google Pay). Without these, sites stay free.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
TRIAL_HOURS=24
# Demo mode: enforce free trials without any payment. Owners reply "keep it" and you activate from WhatsApp
TRIALS=on
PRICE_LABEL=₹499 a month

# Owners' own domains are added to the Render service through the Render API
RENDER_API_KEY=
# Render sets RENDER_SERVICE_ID and RENDER_EXTERNAL_HOSTNAME automatically
RENDER_APEX_IP=216.24.57.1

# Optional email copies of enquiry alerts (resend.com), sent to the address the owner sets with "email you@example.com"
RESEND_API_KEY=
ALERT_EMAIL_FROM=site60 <alerts@site60.in>

# Admin dashboard at https://ROOT_DOMAIN/admin (user: admin)
ADMIN_PASSWORD=
# Secret for signing payment links (defaults to WA_APP_SECRET)
LINK_SECRET=

# Owner numbers (digits only, comma separated) that skip all usage limits, for testing
ADMIN_NUMBERS=
# Optional limit overrides per phone number
LIMIT_SITES_PER_DAY=3
LIMIT_ADVANCED_PER_DAY=3
LIMIT_EDITS_PER_DAY=15
LIMIT_AI_CALLS_PER_DAY=30
LIMIT_PHOTOS_PER_HOUR=20
LIMIT_EDITS_PER_DAY=15
LIMIT_VOICE_PER_DAY=20
